# --- Lyrion Music Server -----------------------------------------------------

# Base URL of the LMS web interface / JSON-RPC endpoint
LMS_URL=http://192.168.1.10:9000

# Optional HTTP basic auth (only if the server has "Password Protection" enabled)
# LMS_USERNAME=
# LMS_PASSWORD=

# Optional: default player when a tool is called without one.
# Accepts a MAC address or an exact player name.
# LMS_DEFAULT_PLAYER=

# --- MCP transport ----------------------------------------------------------

# "stdio" (default, local) or "http" (network endpoint, used by the Docker image)
# MCP_TRANSPORT=stdio

# HTTP transport settings (only used when MCP_TRANSPORT=http)
# MCP_HTTP_PORT=3000
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PATH=/mcp

# Bearer token required on the HTTP endpoint. Strongly recommended when exposed.
# MCP_AUTH_TOKEN=
